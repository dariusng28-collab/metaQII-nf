// =============================================================================
//  metaQII-nf  —  nextflow.config
// =============================================================================

nextflow.enable.strict = true

// -----------------------------------------------------------------------------
// Pipeline identity
// -----------------------------------------------------------------------------

manifest {
    name            = 'metaQII-nf'
    author          = 'metaQII-nf authors'
    homePage        = 'https://github.com/dariusng28-collab/metaQII-nf'
    description     = 'Reproducible Nextflow pipeline for QIIME 2 amplicon analysis (16S & ITS)'
    mainScript      = 'main.nf'
    version         = '2026.1.0'
    nextflowVersion = '>=23.04.0'
}

// -----------------------------------------------------------------------------
// Pipeline parameters
// -----------------------------------------------------------------------------

params {

    // --- Input / output ------------------------------------------------------
    outdir          = 'results'
    input_mode      = 'manifest'
    manifest        = null
    input_dir       = null
    metadata        = null
    classifier      = null

    // --- Sequencing layout ---------------------------------------------------
    paired_end      = true
    sequence_type   = 'ITS'
    its_region      = 'ITS1'
    its_taxa        = 'F'
    run_fastqc      = true
    run_multiqc     = true

    // --- Primer removal (cutadapt; runs only if fwd_primer is set) -----------
    fwd_primer                 = null
    rev_primer                 = null       // required for paired-end primer removal
    cutadapt_error_rate        = 0.1
    cutadapt_discard_untrimmed = true

    // --- Control-based decontamination (runs only if control column is set) --
    decontam_control_column    = null       // metadata column flagging controls
    decontam_control_indicator = 'control'  // value marking a control sample
    decontam_threshold         = 0.1        // decontam score cutoff (keep p>threshold)

    // --- Taxonomic classification method -------------------------------------
    classification_method      = 'sklearn'  // 'sklearn' (trained classifier) or 'vsearch'
    reference_reads            = null        // vsearch: FeatureData[Sequence]
    reference_taxonomy         = null        // vsearch: FeatureData[Taxonomy]
    vsearch_perc_identity      = 0.8
    vsearch_maxaccepts         = 10

    // --- Phylogeny method ----------------------------------------------------
    phylogeny_method           = 'denovo'   // 'denovo' (MAFFT+FastTree) or 'sepp'
    sepp_reference             = null        // SeppReferenceDatabase .qza (sepp only)

    // --- Longitudinal (optional; runs only if both columns are set) ----------
    longitudinal_state_column      = null
    longitudinal_individual_column = null
    longitudinal_metric            = 'shannon_entropy'

    // --- DADA2 denoising -----------------------------------------------------
    trim_left_f            = 0
    trim_left_r            = 0
    trunc_len_f            = 0
    trunc_len_r            = 0
    dada2_pooling          = 'independent'
    dada2_n_reads_learn    = 1000000

    // --- Feature filtering ---------------------------------------------------
    filter_contaminants        = null       // null → auto: true for 16S, false for ITS
    contaminant_taxa           = 'mitochondria,chloroplast'
    filter_min_samples         = 1          // drop features seen in fewer than N samples
    filter_min_frequency       = 0          // drop features with total frequency below N

    // --- Taxonomy classification ---------------------------------------------
    classify_confidence        = 0.7        // classify-sklearn confidence threshold
    classify_reads_per_batch   = 'auto'     // reads per classification batch

    // --- Diversity & taxonomy ------------------------------------------------
    build_phylogeny            = null       // null → auto: false for ITS, true for 16S
    sampling_depth             = null
    metadata_column            = null
    taxonomy_start_level       = 2
    alpha_rarefaction_min_depth = 1
    alpha_rarefaction_max_depth = null      // null → falls back to sampling_depth (warns)
    alpha_rarefaction_steps    = 10
    plot_top_n_taxa            = 15

    // --- Differential abundance (ANCOM-BC2) ----------------------------------
    da_significance_threshold  = 0.05       // q-value cutoff shown in the DA bar plots

    // --- Execution -----------------------------------------------------------
    threads         = 4
    max_cpus        = 16
    max_memory      = '128.GB'
    max_time        = '24.h'

    // Runtime image used by the docker/singularity profiles. Override with
    // --container to point at a different tag or a local Apptainer .sif path.
    container       = 'ghcr.io/dariusng28-collab/metaqii-nf:2026.1.0'
}

// -----------------------------------------------------------------------------
// Process defaults  (no executor here — set per profile)
// -----------------------------------------------------------------------------

process {
    shell        = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [140, 143, 137, 104, 134, 139]
                        ? 'retry'
                        : 'finish' }
    maxRetries   = 2

    withLabel: 'qiime' {
        cpus      = { check_max(params.threads as int,       'cpus')   }
        memory    = { check_max(8.GB  * task.attempt,        'memory') }
        time      = { check_max(4.h   * task.attempt,        'time')   }
        conda     = "${projectDir}/envs/qiime2-amplicon-2026.1-metaqii.yml"
        container = params.container
    }

    withLabel: 'qiime_heavy' {
        cpus      = { check_max(params.threads as int,       'cpus')   }
        memory    = { check_max(32.GB * task.attempt,        'memory') }
        time      = { check_max(12.h  * task.attempt,        'time')   }
        conda     = "${projectDir}/envs/qiime2-amplicon-2026.1-metaqii.yml"
        container = params.container
    }
}

// -----------------------------------------------------------------------------
// Profiles
// -----------------------------------------------------------------------------

profiles {

    // Profiles fall into two independent groups that you compose together:
    //   software provisioning : docker | singularity | conda | prebuilt
    //   compute executor      : standard(local) | sge | slurm | lsf | pbs
    // e.g. reproducible HPC run:  -profile singularity,slurm

    // --- Software provisioning ----------------------------------------------

    // Local / laptop (default): run against whatever QIIME 2 is on PATH.
    standard {
        conda.enabled       = false
        process.executor    = 'local'
        process.cpus        = params.threads
    }

    // Solve the conda environment locally (set useMamba if mamba is present).
    conda {
        conda.enabled       = true
        conda.useMamba      = false
        docker.enabled      = false
        singularity.enabled = false
    }

    // Docker (local development / build host).
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
    }

    // Apptainer / Singularity (HPC): pulls the same image and converts to .sif.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.cacheDir   = "${HOME}/.apptainer/nextflow-cache"
    }

    // Pre-built / already-activated environment (no provisioning by Nextflow).
    prebuilt {
        conda.enabled       = false
        docker.enabled      = false
        singularity.enabled = false
    }

    // --- Compute executors (compose with a provisioning profile) ------------

    sge {
        process.executor        = 'sge'
        process.penv            = 'smp'
        process.queue           = params.containsKey('sge_queue') ? params.sge_queue : 'all.q'
        process.clusterOptions  = { "-V -cwd -l h_vmem=${task.memory.toGiga()}G" }
    }

    slurm {
        process.executor        = 'slurm'
        process.queue           = params.containsKey('slurm_queue') ? params.slurm_queue : 'normal'
        process.clusterOptions  = '--export=ALL'
    }

    lsf {
        process.executor        = 'lsf'
        process.queue           = params.containsKey('lsf_queue') ? params.lsf_queue : 'normal'
        process.clusterOptions  = { "-R 'rusage[mem=${task.memory.toMega()}]'" }
    }

    pbs {
        process.executor        = 'pbs'
        process.queue           = params.containsKey('pbs_queue') ? params.pbs_queue : 'batch'
        process.clusterOptions  = { "-l mem=${task.memory.toGiga()}gb" }
    }

    // --- Test / smoke --------------------------------------------------------

    // Compile/DAG check with the ITS example manifest (does not execute).
    test {
        params.input_mode       = 'manifest'
        params.manifest         = "${projectDir}/assets/example_manifest.tsv"
        params.metadata         = "${projectDir}/assets/example_metadata.tsv"
        params.classifier       = "${projectDir}/assets/dummy-classifier.qza"
        params.sampling_depth   = 100
        params.metadata_column  = 'state_of_disease'
        params.trunc_len_f      = 250
        params.trunc_len_r      = 220
        params.dada2_n_reads_learn = 10000
        params.run_fastqc       = false
        process.executor        = 'local'
    }

    // Runnable smoke test on the bundled toy 16S data. Regenerate the manifest
    // for the current machine first:  python bin/make_toy_16s_dataset.py
    smoke {
        params.input_mode       = 'manifest'
        params.manifest         = "${projectDir}/assets/smoke_test/manifest.tsv"
        params.metadata         = "${projectDir}/assets/smoke_test/metadata.tsv"
        params.classifier       = "${projectDir}/assets/dummy-classifier.qza"
        params.paired_end       = false
        params.sequence_type    = '16S'
        params.build_phylogeny  = false
        params.sampling_depth   = 20
        params.metadata_column  = 'state_of_disease'
        params.dada2_n_reads_learn = 10000
        params.run_fastqc       = false
        process.executor        = 'local'
    }
}

// -----------------------------------------------------------------------------
// Conda settings
// -----------------------------------------------------------------------------

conda {
    createTimeout   = '60 min'
    cacheDir        = "${HOME}/.conda/nextflow-envs"
}

// -----------------------------------------------------------------------------
// Pipeline reports
// -----------------------------------------------------------------------------

timeline {
    enabled     = true
    file        = "${params.outdir}/pipeline_info/timeline.html"
    overwrite   = true
}
report {
    enabled     = true
    file        = "${params.outdir}/pipeline_info/report.html"
    overwrite   = true
}
trace {
    enabled     = true
    file        = "${params.outdir}/pipeline_info/trace.txt"
    overwrite   = true
    fields      = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,%cpu,%mem,rss,vmem'
}
dag {
    enabled     = true
    file        = "${params.outdir}/pipeline_info/dag.html"
    overwrite   = true
}

// -----------------------------------------------------------------------------
// Resource ceiling helper — prevents requests exceeding what the host allows
// -----------------------------------------------------------------------------

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    }
}
